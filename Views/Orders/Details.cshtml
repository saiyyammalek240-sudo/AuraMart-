@model ParkEasePro.Models.Order
@{
    ViewData["Title"] = $"Order Details - {Model.OrderNumber}";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a asp-action="Index">My Orders</a></li>
                    <li class="breadcrumb-item active">@Model.OrderNumber</li>
                </ol>
            </nav>
            <h2 class="fw-bold mb-0">Order Summary &amp; Tracking</h2>
        </div>
        <a asp-action="Invoice" asp-route-id="@Model.Id" class="btn btn-outline-success btn-sm rounded-pill px-3">
            <i class="bi bi-printer me-1"></i> Print Invoice
        </a>
    </div>

    <!-- Stepper Tracker -->
    <div class="card border-0 shadow-sm p-4 bg-white mb-4">
        <h6 class="fw-bold text-dark text-uppercase small tracking-wider mb-3">Shipment Timeline</h6>
        <div class="row g-2 text-center small">
            @{
                int currentStep = Model.Status switch
                {
                    ParkEasePro.Models.OrderStatus.Placed => 1,
                    ParkEasePro.Models.OrderStatus.Processing => 2,
                    ParkEasePro.Models.OrderStatus.Shipped => 3,
                    ParkEasePro.Models.OrderStatus.Delivered => 4,
                    _ => 1
                };
            }
            <div class="col-3">
                <div class="p-2 rounded @(currentStep >= 1 ? "bg-success-subtle text-success border border-success-subtle fw-bold" : "bg-light text-muted border")">
                    <i class="bi bi-check-circle-fill d-block fs-5"></i> 1. Placed
                </div>
            </div>
            <div class="col-3">
                <div class="p-2 rounded @(currentStep >= 2 ? "bg-success-subtle text-success border border-success-subtle fw-bold" : "bg-light text-muted border")">
                    <i class="bi bi-gear-fill d-block fs-5"></i> 2. Processing
                </div>
            </div>
            <div class="col-3">
                <div class="p-2 rounded @(currentStep >= 3 ? "bg-success-subtle text-success border border-success-subtle fw-bold" : "bg-light text-muted border")">
                    <i class="bi bi-truck d-block fs-5"></i> 3. Shipped
                </div>
            </div>
            <div class="col-3">
                <div class="p-2 rounded @(currentStep >= 4 ? "bg-success-subtle text-success border border-success-subtle fw-bold" : "bg-light text-muted border")">
                    <i class="bi bi-house-check d-block fs-5"></i> 4. Delivered
                </div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.TrackingNumber))
        {
            <div class="mt-3 p-2 bg-light rounded text-center small text-muted">
                Tracking Number: <strong class="mono-font text-dark">@Model.TrackingNumber</strong> &bull; Estimated Delivery: <strong>@(Model.EstimatedDelivery?.ToString("dd MMM yyyy") ?? "Soon")</strong>
            </div>
        }
    </div>

    <!-- Items & Address Row -->
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm p-4 bg-white">
                <h5 class="fw-bold mb-3">Itemized Details</h5>
                <div class="table-responsive">
                    <table class="table align-middle small mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Item</th>
                                <th>Unit Price</th>
                                <th>Qty</th>
                                <th class="text-end">Subtotal</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var i in Model.Items)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <img src="@i.ProductImageUrl" alt="@i.ProductName" class="rounded border" style="width: 40px; height: 40px; object-fit: cover;" />
                                            <span class="fw-semibold">@i.ProductName</span>
                                        </div>
                                    </td>
                                    <td>₹@i.UnitPrice.ToString("0.00")</td>
                                    <td>@i.Quantity</td>
                                    <td class="text-end fw-bold">₹@i.SubTotal.ToString("0.00")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm p-4 bg-white mb-3">
                <h6 class="fw-bold text-dark small text-uppercase tracking-wider mb-2">Shipping Information</h6>
                <div class="small text-muted">
                    <strong class="text-dark">@Model.ShippingFullName</strong><br />
                    Phone: @Model.ShippingPhone<br />
                    @Model.ShippingAddress<br />
                    @Model.ShippingCity - @Model.ShippingPostalCode
                </div>
            </div>

            <div class="card border-0 shadow-sm p-4 bg-white">
                <h6 class="fw-bold text-dark small text-uppercase tracking-wider mb-2">Payment Details</h6>
                <div class="d-flex justify-content-between small mb-1">
                    <span class="text-muted">Method:</span>
                    <span class="fw-semibold text-dark">@Model.PaymentMethod</span>
                </div>
                <div class="d-flex justify-content-between small mb-1">
                    <span class="text-muted">Status:</span>
                    <span class="badge bg-success-subtle text-success">@Model.PaymentStatus</span>
                </div>
                <div class="d-flex justify-content-between small mb-2">
                    <span class="text-muted">Transaction ID:</span>
                    <span class="mono-font">@Model.TransactionId</span>
                </div>

                <hr class="my-2" />

                <div class="d-flex justify-content-between align-items-center">
                    <span class="fw-bold text-dark">Grand Total:</span>
                    <span class="fs-4 fw-extrabold text-success">₹@Model.GrandTotal.ToString("0.00")</span>
                </div>
            </div>
        </div>
    </div>
</div>
