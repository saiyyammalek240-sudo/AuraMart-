@{
    ViewData["Title"] = "Access Denied — AuraMart";
}

<div class="container py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4 p-5">
                <div class="text-danger mb-3">
                    <i class="bi bi-shield-x display-1"></i>
                </div>
                <h2 class="fw-bold text-dark mb-2">Access Denied</h2>
                <p class="text-muted mb-4">
                    You do not have permission to access this resource. Please make sure you are logged in with the appropriate administrative role.
                </p>
                <div class="d-flex justify-content-center gap-2">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                        <i class="bi bi-house me-1"></i> Back to Store
                    </a>
                    <a asp-controller="Account" asp-action="Login" class="btn btn-success rounded-pill px-4">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Switch Account
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
