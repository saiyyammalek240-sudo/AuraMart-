@model ParkEasePro.Models.ViewModels.AdminEcommerceDashboardViewModel
@{
    ViewData["Title"] = "Store Sales & Operations Dashboard";
}

<div class="container py-4">
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-danger text-white px-3 py-1 rounded-pill fw-bold">MERCHANT CONSOLE</span>
                <span class="text-muted small">Store Performance &amp; Telemetry</span>
            </div>
            <h2 class="fw-bold mb-0 text-dark"><i class="bi bi-speedometer2 text-danger me-2"></i>Executive Sales Dashboard</h2>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a asp-action="Products" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                <i class="bi bi-boxes"></i> Inventory
            </a>
            <a asp-action="Orders" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                <i class="bi bi-receipt"></i> Orders
            </a>
            <a asp-action="ExportOrdersCsv" class="btn btn-success btn-sm rounded-pill px-3 shadow-sm">
                <i class="bi bi-download me-1"></i> Export Orders CSV
            </a>
        </div>
    </div>

    <!-- 4 KPI Stat Cards -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm p-3 bg-white h-100">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <span class="small text-muted fw-semibold text-uppercase tracking-wider">Total Revenue</span>
                        <h3 class="fw-extrabold text-success mb-0 mt-1">₹@Model.TotalSalesRevenue.ToString("0.00")</h3>
                        <small class="text-muted">₹@Model.MonthSalesRevenue this month</small>
                    </div>
                    <div class="rounded-3 bg-success-subtle text-success d-flex align-items-center justify-content-center" style="width: 44px; height: 44px; font-size: 1.4rem;">
                        <i class="bi bi-currency-rupee"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm p-3 bg-white h-100">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <span class="small text-muted fw-semibold text-uppercase tracking-wider">Total Orders</span>
                        <h3 class="fw-extrabold text-dark mb-0 mt-1">@Model.TotalOrdersCount</h3>
                        <small class="text-muted">Across @Model.ActiveCustomersCount customers</small>
                    </div>
                    <div class="rounded-3 bg-primary-subtle text-primary d-flex align-items-center justify-content-center" style="width: 44px; height: 44px; font-size: 1.4rem;">
                        <i class="bi bi-bag-check"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm p-3 bg-white h-100">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <span class="small text-muted fw-semibold text-uppercase tracking-wider">Catalog SKUs</span>
                        <h3 class="fw-extrabold text-dark mb-0 mt-1">@Model.TotalProductsCount</h3>
                        <small class="text-muted">Active items</small>
                    </div>
                    <div class="rounded-3 bg-info-subtle text-info d-flex align-items-center justify-content-center" style="width: 44px; height: 44px; font-size: 1.4rem;">
                        <i class="bi bi-boxes"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm p-3 bg-white h-100">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <span class="small text-muted fw-semibold text-uppercase tracking-wider">Low Stock Alert</span>
                        <h3 class="fw-extrabold text-danger mb-0 mt-1">@Model.LowStockProductsCount</h3>
                        <small class="text-danger">&le; 10 units remaining</small>
                    </div>
                    <div class="rounded-3 bg-danger-subtle text-danger d-flex align-items-center justify-content-center" style="width: 44px; height: 44px; font-size: 1.4rem;">
                        <i class="bi bi-exclamation-triangle"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts Row -->
    <div class="row g-4 mb-4">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm p-4 bg-white h-100">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-graph-up text-success me-2"></i>7-Day Sales Revenue Trend</h5>
                    <span class="badge bg-light text-muted border">Daily Inflow (₹)</span>
                </div>
                <div style="height: 280px;">
                    <canvas id="salesTrendChart"></canvas>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm p-4 bg-white h-100">
                <h5 class="fw-bold mb-3 text-dark"><i class="bi bi-pie-chart text-primary me-2"></i>Category Inventory</h5>
                <div style="height: 240px;" class="d-flex justify-content-center align-items-center">
                    <canvas id="categoryDonutChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Orders Table -->
    <div class="card border-0 shadow-sm p-4 bg-white">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-receipt text-secondary me-2"></i>Recent Customer Orders</h5>
            <a asp-action="Orders" class="small text-success text-decoration-none fw-semibold">View All Orders</a>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 small">
                <thead class="table-light">
                    <tr>
                        <th>Order #</th>
                        <th>Customer</th>
                        <th>Date</th>
                        <th>Items</th>
                        <th>Grand Total</th>
                        <th>Payment</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var o in Model.RecentOrders)
                    {
                        <tr>
                            <td class="mono-font fw-bold">@o.OrderNumber</td>
                            <td>@o.ShippingFullName</td>
                            <td>@o.OrderDate.ToString("dd MMM, hh:mm tt")</td>
                            <td>@o.Items.Count items</td>
                            <td class="fw-bold text-success">₹@o.GrandTotal.ToString("0.00")</td>
                            <td><span class="badge bg-light text-dark border">@o.PaymentMethod</span></td>
                            <td>
                                <span class="badge @(o.Status == ParkEasePro.Models.OrderStatus.Delivered ? "bg-success" : o.Status == ParkEasePro.Models.OrderStatus.Shipped ? "bg-info text-dark" : "bg-warning text-dark")">
                                    @o.Status
                                </span>
                            </td>
                            <td>
                                <a asp-controller="Orders" asp-action="Details" asp-route-id="@o.Id" class="btn btn-outline-primary btn-sm py-0">
                                    Inspect
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // 7-day Sales Bar Chart
            const salesCtx = document.getElementById('salesTrendChart').getContext('2d');
            new Chart(salesCtx, {
                type: 'bar',
                data: {
                    labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RevenueDates)),
                    datasets: [{
                        label: 'Revenue (₹)',
                        data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DailyRevenues)),
                        backgroundColor: 'rgba(5, 150, 105, 0.75)',
                        borderColor: '#059669',
                        borderWidth: 1.5,
                        borderRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: { callback: function(val) { return '₹' + val; } }
                        }
                    }
                }
            });

            // Category Donut
            const catCtx = document.getElementById('categoryDonutChart').getContext('2d');
            new Chart(catCtx, {
                type: 'doughnut',
                data: {
                    labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CategoryLabels)),
                    datasets: [{
                        data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CategoryCounts)),
                        backgroundColor: ['#059669', '#10b981', '#34d399', '#6ee7b7']
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'bottom', labels: { boxWidth: 12, font: { size: 11 } } }
                    }
                }
            });
        });
    </script>
}
