@model ParkEasePro.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Sign In — AuraMart";
    var returnUrl = ViewData["ReturnUrl"] as string;
    bool isGoogleConfigured = ViewBag.IsGoogleConfigured ?? false;
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-5">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="card-body p-4 p-md-5">
                    <!-- Header -->
                    <div class="text-center mb-4">
                        <div class="d-inline-flex align-items-center justify-content-center bg-success-subtle text-success rounded-circle mb-3" style="width: 56px; height: 56px;">
                            <i class="bi bi-person-lock fs-2"></i>
                        </div>
                        <h3 class="fw-bold text-dark mb-1">Welcome Back</h3>
                        <p class="text-muted small">Access your AuraMart shopping cart, orders, and perks</p>
                    </div>

                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show rounded-3 small" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <!-- 1-Click Google Sign In Button -->
                    <form asp-action="ExternalLogin" method="post" class="mb-3">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="provider" value="Google" />
                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                        <button type="submit" class="btn btn-outline-secondary w-100 py-2 d-flex align-items-center justify-content-center gap-3 rounded-pill fw-semibold shadow-sm hover-shadow bg-white border">
                            <svg width="20" height="20" viewBox="0 0 48 48">
                                <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
                                <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
                                <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
                                <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
                            </svg>
                            <span>Continue with Google</span>
                        </button>
                    </form>

                    <div class="position-relative text-center my-4">
                        <hr class="text-muted opacity-25 m-0" />
                        <span class="position-absolute top-50 start-50 translate-middle bg-white px-3 text-muted small fw-medium">
                            or sign in with email
                        </span>
                    </div>

                    <!-- Email & Password Form -->
                    <form asp-action="Login" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="ReturnUrl" />

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small rounded-3 mb-3" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label small fw-semibold text-secondary"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-envelope"></i></span>
                                <input asp-for="Email" class="form-control bg-light border-start-0" placeholder="name@example.com" />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <div class="d-flex justify-content-between align-items-center">
                                <label asp-for="Password" class="form-label small fw-semibold text-secondary mb-0"></label>
                            </div>
                            <div class="input-group mt-1">
                                <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-key"></i></span>
                                <input asp-for="Password" class="form-control bg-light border-start-0" placeholder="••••••••" />
                            </div>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="form-check mb-4">
                            <input class="form-check-input" asp-for="RememberMe" />
                            <label class="form-check-label small text-muted" asp-for="RememberMe">
                                Keep me signed in on this device
                            </label>
                        </div>

                        <button type="submit" class="btn btn-success w-100 py-2 rounded-pill fw-semibold shadow-sm">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
                        </button>
                    </form>

                    <!-- Fast Test Fill for Evaluators -->
                    <div class="mt-4 pt-3 border-top text-center">
                        <button class="btn btn-link text-decoration-none text-muted small p-0" type="button" data-bs-toggle="collapse" data-bs-target="#demoFill">
                            <i class="bi bi-magic me-1 text-warning"></i> Need quick evaluator credentials? Click here
                        </button>
                        <div class="collapse mt-2" id="demoFill">
                            <div class="d-flex gap-2 justify-content-center">
                                <button type="button" class="btn btn-outline-danger btn-sm rounded-pill" onclick="fillCreds('admin@auramart.com', 'Admin@123')">
                                    <i class="bi bi-shield-lock"></i> Fill Admin
                                </button>
                                <button type="button" class="btn btn-outline-success btn-sm rounded-pill" onclick="fillCreds('customer@auramart.com', 'Customer@123')">
                                    <i class="bi bi-person"></i> Fill Customer
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card-footer bg-light border-0 py-3 text-center">
                    <span class="small text-muted">Don't have an account yet?</span>
                    <a asp-action="Register" asp-route-returnUrl="@returnUrl" class="small fw-bold text-success text-decoration-none ms-1">
                        Create an account
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function fillCreds(email, pass) {
            document.getElementById('Email').value = email;
            document.getElementById('Password').value = pass;
        }
    </script>
}
