@model List<ParkEasePro.Models.Product>
@{
    ViewData["Title"] = "Manage Product Inventory";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h2 class="fw-bold mb-1"><i class="bi bi-boxes text-danger me-2"></i>Product Catalog Inventory</h2>
            <p class="text-muted small mb-0">Total of @Model.Count SKUs in the store database.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Dashboard" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                <i class="bi bi-arrow-left"></i> Dashboard
            </a>
            <a asp-action="CreateProduct" class="btn btn-success btn-sm rounded-pill px-3 shadow-sm">
                <i class="bi bi-plus-lg me-1"></i> Add New Product
            </a>
        </div>
    </div>

    <!-- Filter by Category -->
    <div class="card border-0 shadow-sm p-3 mb-4 bg-white">
        <form method="get" asp-action="Products" class="row g-2 align-items-center">
            <div class="col-md-4">
                <select name="categoryId" asp-items="ViewBag.Categories" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">-- All Categories --</option>
                </select>
            </div>
            <div class="col-md-4">
                <input type="text" name="search" class="form-control form-control-sm" placeholder="Search by name or brand..." />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-outline-secondary btn-sm w-100">Search</button>
            </div>
            <div class="col-md-2">
                <a asp-action="Products" class="btn btn-link text-muted btn-sm">Reset</a>
            </div>
        </form>
    </div>

    <!-- Table -->
    <div class="card border-0 shadow-sm p-4 bg-white">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 small">
                <thead class="table-light">
                    <tr>
                        <th>Item</th>
                        <th>Category</th>
                        <th>SKU</th>
                        <th>Price</th>
                        <th>Stock</th>
                        <th>Badges</th>
                        <th>Rating</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <img src="@p.ImageUrl" alt="@p.Name" class="rounded border" style="width: 44px; height: 44px; object-fit: cover;" />
                                    <div>
                                        <span class="fw-bold text-dark d-block text-truncate" style="max-width: 220px;">@p.Name</span>
                                        <small class="text-muted">@p.Brand</small>
                                    </div>
                                </div>
                            </td>
                            <td><span class="badge bg-light text-dark border">@p.Category.Name</span></td>
                            <td class="mono-font">@p.SKU</td>
                            <td class="fw-bold text-success">₹@p.Price.ToString("0.00")</td>
                            <td>
                                @if (p.StockQuantity <= 10)
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle">@p.StockQuantity left</span>
                                }
                                else
                                {
                                    <span class="badge bg-success-subtle text-success">@p.StockQuantity</span>
                                }
                            </td>
                            <td>
                                @if (p.IsFeatured) { <span class="badge bg-primary me-1">Featured</span> }
                                @if (p.IsTrending) { <span class="badge bg-info text-dark me-1">Trend</span> }
                                @if (p.IsOnSale) { <span class="badge bg-danger">Sale</span> }
                            </td>
                            <td>⭐ @p.Rating (@p.ReviewCount)</td>
                            <td>
                                <div class="d-flex gap-1">
                                    <a asp-action="EditProduct" asp-route-id="@p.Id" class="btn btn-outline-secondary btn-sm py-0" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form asp-action="DeleteProduct" asp-route-id="@p.Id" method="post" onsubmit="return confirm('Delete product @p.Name?');" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-danger btn-sm py-0" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
