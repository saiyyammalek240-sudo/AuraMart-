@model ParkEasePro.Models.ViewModels.ShopCatalogViewModel
@{
    ViewData["Title"] = "Shop All Products";
}

<div class="container py-4">
    <!-- Breadcrumb & Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="breadcrumb-item active">Shop</li>
                </ol>
            </nav>
            <h2 class="fw-bold text-dark mb-0">Product Catalog</h2>
        </div>
        <div class="text-muted small">
            Showing <strong>@Model.Products.Count</strong> of <strong>@Model.TotalItems</strong> items
        </div>
    </div>

    <div class="row g-4">
        <!-- Sidebar Filters -->
        <div class="col-lg-3">
            <div class="card border-0 shadow-sm p-4 bg-white sticky-top" style="top: 85px;">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-funnel text-success me-1"></i> Filters</h5>
                    <a asp-action="Index" class="small text-muted text-decoration-none">Clear All</a>
                </div>

                <form method="get" asp-action="Index">
                    <!-- Search query preserved -->
                    @if (!string.IsNullOrEmpty(Model.SearchTerm))
                    {
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Search Query</label>
                            <input type="text" name="q" value="@Model.SearchTerm" class="form-control form-control-sm" />
                        </div>
                    }

                    <!-- Categories Filter -->
                    <div class="mb-4">
                        <label class="form-label small fw-bold text-uppercase text-muted">Category</label>
                        <div class="d-flex flex-column gap-2">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="categoryId" value="" id="catAll" @(!Model.SelectedCategoryId.HasValue ? "checked" : "") onchange="this.form.submit()">
                                <label class="form-check-label small" for="catAll">All Categories</label>
                            </div>
                            @foreach (var c in Model.Categories)
                            {
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="categoryId" value="@c.Id" id="cat_@c.Id" @(Model.SelectedCategoryId == c.Id ? "checked" : "") onchange="this.form.submit()">
                                    <label class="form-check-label small d-flex justify-content-between" for="cat_@c.Id">
                                        <span>@c.Name</span>
                                        <span class="text-muted">(@c.Products.Count)</span>
                                    </label>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Price Range -->
                    <div class="mb-4">
                        <label class="form-label small fw-bold text-uppercase text-muted">Price Range (₹)</label>
                        <div class="row g-2 mb-2">
                            <div class="col-6">
                                <input type="number" name="minPrice" value="@Model.MinPrice" class="form-control form-control-sm" placeholder="Min" />
                            </div>
                            <div class="col-6">
                                <input type="number" name="maxPrice" value="@Model.MaxPrice" class="form-control form-control-sm" placeholder="Max" />
                            </div>
                        </div>
                    </div>

                    <!-- Sort -->
                    <div class="mb-4">
                        <label class="form-label small fw-bold text-uppercase text-muted">Sort By</label>
                        <select name="sort" class="form-select form-select-sm" onchange="this.form.submit()">
                            <option value="newest" selected="@(Model.SortBy == "newest")">Newest Arrivals</option>
                            <option value="price_asc" selected="@(Model.SortBy == "price_asc")">Price: Low to High</option>
                            <option value="price_desc" selected="@(Model.SortBy == "price_desc")">Price: High to Low</option>
                            <option value="rating" selected="@(Model.SortBy == "rating")">Customer Rating</option>
                        </select>
                    </div>

                    <button type="submit" class="btn btn-success btn-sm w-100 rounded-pill">
                        Apply Filters
                    </button>
                </form>
            </div>
        </div>

        <!-- Products Grid & Pagination -->
        <div class="col-lg-9">
            @if (!Model.Products.Any())
            {
                <div class="card border-0 shadow-sm p-5 text-center my-4 bg-white">
                    <i class="bi bi-search text-muted fs-1 mb-2"></i>
                    <h5 class="fw-bold">No products found</h5>
                    <p class="text-muted small">Try broadening your search term or clearing price filters.</p>
                    <div>
                        <a asp-action="Index" class="btn btn-outline-success btn-sm rounded-pill px-4">
                            Clear All Filters
                        </a>
                    </div>
                </div>
            }
            else
            {
                <div class="row g-4 mb-4">
                    @foreach (var p in Model.Products)
                    {
                        <div class="col-sm-6 col-md-4">
                            <div class="product-card">
                                <div class="product-img-wrapper">
                                    <img src="@p.ImageUrl" alt="@p.Name" loading="lazy" />
                                    <div class="product-badge-strip">
                                        @if (p.DiscountPercent > 0)
                                        {
                                            <span class="badge bg-danger rounded-pill fw-bold">@p.DiscountPercent% OFF</span>
                                        }
                                        @if (p.IsFeatured)
                                        {
                                            <span class="badge bg-primary rounded-pill fw-bold">FEATURED</span>
                                        }
                                    </div>
                                </div>

                                <div class="p-3 d-flex flex-column flex-grow-1">
                                    <span class="small text-muted text-uppercase fw-semibold" style="font-size: 11px;">@p.Brand</span>
                                    <h6 class="fw-bold text-dark mb-1 text-truncate">
                                        <a asp-controller="Shop" asp-action="Details" asp-route-id="@p.Id" class="text-decoration-none text-dark">
                                            @p.Name
                                        </a>
                                    </h6>

                                    <div class="d-flex align-items-center gap-1 mb-2">
                                        <span class="text-warning small"><i class="bi bi-star-fill"></i> @p.Rating</span>
                                        <span class="text-muted small" style="font-size: 11px;">(@p.ReviewCount)</span>
                                    </div>

                                    <div class="mt-auto pt-2 border-top d-flex justify-content-between align-items-center">
                                        <div>
                                            <span class="fs-5 fw-extrabold text-success">₹@p.Price.ToString("0.00")</span>
                                            @if (p.OriginalPrice > p.Price)
                                            {
                                                <span class="text-muted text-decoration-line-through small ms-1" style="font-size: 11px;">₹@p.OriginalPrice.ToString("0.00")</span>
                                            }
                                        </div>
                                        <form asp-controller="Cart" asp-action="AddToCart" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="productId" value="@p.Id" />
                                            <button type="submit" class="btn btn-outline-success btn-sm rounded-circle p-0 d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;" title="Add to Cart">
                                                <i class="bi bi-cart-plus-fill fs-6"></i>
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Pagination -->
                @if (Model.TotalPages > 1)
                {
                    <nav class="d-flex justify-content-center mt-4">
                        <ul class="pagination pagination-sm">
                            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)" asp-route-categoryId="@Model.SelectedCategoryId" asp-route-q="@Model.SearchTerm" asp-route-sort="@Model.SortBy">&laquo; Prev</a>
                            </li>
                            @for (int i = 1; i <= Model.TotalPages; i++)
                            {
                                <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                                    <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-categoryId="@Model.SelectedCategoryId" asp-route-q="@Model.SearchTerm" asp-route-sort="@Model.SortBy">@i</a>
                                </li>
                            }
                            <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)" asp-route-categoryId="@Model.SelectedCategoryId" asp-route-q="@Model.SearchTerm" asp-route-sort="@Model.SortBy">Next &raquo;</a>
                            </li>
                        </ul>
                    </nav>
                }
            }
        </div>
    </div>
</div>
