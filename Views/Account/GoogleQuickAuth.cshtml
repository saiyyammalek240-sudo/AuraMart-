@model ParkEasePro.Models.ViewModels.GoogleAuthSimulationViewModel
@{
    ViewData["Title"] = "Sign in with Google — Simulator";
    var returnUrl = ViewData["ReturnUrl"] as string;
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-5">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="card-body p-4 p-md-5 text-center">
                    <!-- Google Logo -->
                    <div class="d-inline-flex align-items-center justify-content-center p-3 rounded-circle bg-light shadow-sm mb-3">
                        <svg width="40" height="40" viewBox="0 0 48 48">
                            <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
                            <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
                            <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
                            <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
                        </svg>
                    </div>

                    <h4 class="fw-bold text-dark mb-1">Sign in with Google</h4>
                    <p class="text-muted small mb-4">Choose an account to continue to <strong>AuraMart</strong></p>

                    <!-- Fast Clickable Google Account Profile (One-Tap Style) -->
                    <form asp-action="GoogleQuickAuth" method="post" class="mb-4">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="ReturnUrl" />
                        <input type="hidden" name="Email" value="alex.creator@gmail.com" />
                        <input type="hidden" name="FullName" value="Alex Mercer" />

                        <button type="submit" class="btn btn-outline-light text-start text-dark w-100 p-3 rounded-4 border d-flex align-items-center gap-3 shadow-sm hover-shadow">
                            <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold fs-5" style="width: 44px; height: 44px;">
                                A
                            </div>
                            <div class="flex-grow-1">
                                <span class="fw-bold d-block">Alex Mercer</span>
                                <span class="text-muted small">alex.creator@gmail.com</span>
                            </div>
                            <i class="bi bi-chevron-right text-muted"></i>
                        </button>
                    </form>

                    <!-- Or enter any custom Google account -->
                    <div class="text-start">
                        <button class="btn btn-link text-decoration-none text-muted small p-0 mb-3" type="button" data-bs-toggle="collapse" data-bs-target="#customGoogleForm">
                            <i class="bi bi-person-plus me-1 text-primary"></i> Or sign in with a different Google account
                        </button>

                        <div class="collapse" id="customGoogleForm">
                            <form asp-action="GoogleQuickAuth" method="post" class="p-3 bg-light rounded-3 border">
                                @Html.AntiForgeryToken()
                                <input type="hidden" asp-for="ReturnUrl" />

                                <div class="mb-2">
                                    <label class="form-label small fw-semibold text-secondary">Full Name</label>
                                    <input asp-for="FullName" class="form-control form-control-sm" placeholder="Your Name" />
                                    <span asp-validation-for="FullName" class="text-danger small"></span>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label small fw-semibold text-secondary">Google Email</label>
                                    <input asp-for="Email" class="form-control form-control-sm" placeholder="you@gmail.com" />
                                    <span asp-validation-for="Email" class="text-danger small"></span>
                                </div>

                                <button type="submit" class="btn btn-primary btn-sm w-100 rounded-pill fw-semibold">
                                    Continue with This Account
                                </button>
                            </form>
                        </div>
                    </div>

                    <!-- Developer / Evaluator Notice -->
                    <div class="alert alert-light border small text-muted text-start mt-4 mb-0 rounded-3">
                        <div class="d-flex align-items-center gap-2 fw-semibold text-dark mb-1">
                            <i class="bi bi-info-circle-fill text-primary"></i> Ready for Live Google Cloud OAuth
                        </div>
                        <p class="mb-1" style="font-size: 11px;">
                            To hook into live Google Cloud credentials, set <code>Authentication:Google:ClientId</code> and <code>ClientSecret</code> in <code>appsettings.json</code>.
                        </p>
                    </div>
                </div>

                <div class="card-footer bg-light border-0 py-3 text-center">
                    <a asp-action="Login" asp-route-returnUrl="@returnUrl" class="small text-muted text-decoration-none">
                        <i class="bi bi-arrow-left me-1"></i> Back to AuraMart Sign In
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
