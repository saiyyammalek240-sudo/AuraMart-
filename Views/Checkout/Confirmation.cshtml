@model ParkEasePro.Models.Order
@{
    ViewData["Title"] = $"Order Confirmed - {Model.OrderNumber}";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden bg-white">
                <!-- Header -->
                <div class="p-5 text-center bg-success text-white">
                    <div class="rounded-circle bg-white text-success d-inline-flex align-items-center justify-content-center mb-3 shadow" style="width: 70px; height: 70px; font-size: 2.2rem;">
                        <i class="bi bi-check2"></i>
                    </div>
                    <h2 class="fw-bold mb-1">Order Successfully Placed!</h2>
                    <p class="mb-0 text-white-50">Thank you for your purchase. We have received your order and are preparing shipment.</p>
                </div>

                <div class="p-4 p-md-5">
                    <!-- Tracking Metadata Strip -->
                    <div class="d-flex flex-wrap justify-content-between align-items-center p-3 bg-light rounded-3 border mb-4">
                        <div>
                            <span class="small text-muted d-block text-uppercase">Order Reference</span>
                            <span class="mono-font fw-extrabold text-dark fs-5">@Model.OrderNumber</span>
                        </div>
                        <div>
                            <span class="small text-muted d-block text-uppercase">Payment Method</span>
                            <span class="badge bg-success-subtle text-success border border-success-subtle">@Model.PaymentMethod (@Model.PaymentStatus)</span>
                        </div>
                        <div>
                            <span class="small text-muted d-block text-uppercase">Estimated Delivery</span>
                            <span class="fw-semibold text-dark">@(Model.EstimatedDelivery?.ToString("dd MMM yyyy") ?? "In 3-4 Days")</span>
                        </div>
                    </div>

                    <!-- Order Tracking Stepper -->
                    <div class="mb-5">
                        <h6 class="fw-bold text-dark text-uppercase small tracking-wider mb-3">Live Order Tracking Timeline</h6>
                        <div class="row g-2 text-center small">
                            <div class="col-3">
                                <div class="p-2 rounded bg-success-subtle text-success border border-success-subtle fw-bold">
                                    <i class="bi bi-check-circle-fill d-block fs-5"></i> Placed
                                </div>
                            </div>
                            <div class="col-3">
                                <div class="p-2 rounded bg-success-subtle text-success border border-success-subtle fw-bold">
                                    <i class="bi bi-gear-fill d-block fs-5"></i> Processing
                                </div>
                            </div>
                            <div class="col-3">
                                <div class="p-2 rounded bg-light text-muted border">
                                    <i class="bi bi-truck d-block fs-5"></i> Shipped
                                </div>
                            </div>
                            <div class="col-3">
                                <div class="p-2 rounded bg-light text-muted border">
                                    <i class="bi bi-house-check d-block fs-5"></i> Delivered
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Ordered Items Summary Table -->
                    <h6 class="fw-bold text-dark text-uppercase small tracking-wider mb-3">Purchased Items</h6>
                    <div class="table-responsive mb-4">
                        <table class="table table-bordered align-middle small mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Item</th>
                                    <th>Unit Price</th>
                                    <th>Quantity</th>
                                    <th class="text-end">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Items)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                <img src="@item.ProductImageUrl" alt="@item.ProductName" class="rounded border" style="width: 40px; height: 40px; object-fit: cover;" />
                                                <span class="fw-semibold">@item.ProductName</span>
                                            </div>
                                        </td>
                                        <td>₹@item.UnitPrice.ToString("0.00")</td>
                                        <td>@item.Quantity</td>
                                        <td class="text-end fw-bold">₹@item.SubTotal.ToString("0.00")</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="3" class="text-end text-muted">Subtotal:</td>
                                    <td class="text-end fw-semibold">₹@Model.SubTotal.ToString("0.00")</td>
                                </tr>
                                @if (Model.DiscountAmount > 0)
                                {
                                    <tr class="text-success">
                                        <td colspan="3" class="text-end">Promo Discount:</td>
                                        <td class="text-end fw-bold">- ₹@Model.DiscountAmount.ToString("0.00")</td>
                                    </tr>
                                }
                                <tr>
                                    <td colspan="3" class="text-end text-muted">Shipping Fee:</td>
                                    <td class="text-end">@(Model.ShippingFee == 0 ? "FREE" : "₹" + Model.ShippingFee.ToString("0.00"))</td>
                                </tr>
                                <tr class="table-light">
                                    <td colspan="3" class="text-end fw-bold fs-6">Grand Total:</td>
                                    <td class="text-end fw-extrabold text-success fs-5">₹@Model.GrandTotal.ToString("0.00")</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>

                    <!-- Shipping Address Snapshot -->
                    <div class="p-3 bg-light rounded-3 border mb-4">
                        <h6 class="fw-bold text-dark small mb-1">Delivering to:</h6>
                        <div class="small text-muted">
                            <strong class="text-dark">@Model.ShippingFullName</strong> &bull; @Model.ShippingPhone<br />
                            @Model.ShippingAddress, @Model.ShippingCity - @Model.ShippingPostalCode
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="d-flex justify-content-between align-items-center pt-2">
                        <a asp-controller="Orders" asp-action="Invoice" asp-route-id="@Model.Id" class="btn btn-outline-dark rounded-pill px-4">
                            <i class="bi bi-printer me-1"></i> Print Tax Invoice
                        </a>
                        <a asp-controller="Shop" asp-action="Index" class="btn btn-success rounded-pill px-4 shadow">
                            Continue Shopping <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
