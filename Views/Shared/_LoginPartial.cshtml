@using Microsoft.AspNetCore.Identity
@using ParkEasePro.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav align-items-center gap-1">
@if (SignInManager.IsSignedIn(User))
{
    var currentUser = await UserManager.GetUserAsync(User);
    var displayName = currentUser?.FullName ?? User.Identity?.Name ?? "User";
    var isAdmin = User.IsInRole("Admin");

    <li class="nav-item dropdown">
        <a class="nav-link dropdown-toggle d-flex align-items-center gap-2 py-1 px-2 rounded-3 border bg-light text-dark" href="#" id="userMenu" role="button" data-bs-toggle="dropdown" aria-expanded="false">
            <div class="rounded-circle bg-success text-white d-flex align-items-center justify-content-center fw-bold" style="width: 28px; height: 28px; font-size: 13px;">
                @(displayName.Length > 0 ? displayName[0].ToString().ToUpper() : "U")
            </div>
            <div class="d-flex flex-column text-start lh-1 me-1">
                <span class="fw-semibold small">@displayName</span>
                <span class="badge @(isAdmin ? "bg-danger" : "bg-success") px-1 py-0" style="font-size: 10px;">@(isAdmin ? "Admin" : "Customer")</span>
            </div>
        </a>
        <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 py-2" aria-labelledby="userMenu">
            <li><h6 class="dropdown-header text-uppercase tracking-wider small text-muted">Customer Portal</h6></li>
            <li><a class="dropdown-item d-flex align-items-center gap-2" asp-controller="Orders" asp-action="Index"><i class="bi bi-box-seam text-success"></i> My Orders</a></li>
            <li><a class="dropdown-item d-flex align-items-center gap-2" asp-controller="Cart" asp-action="Index"><i class="bi bi-cart3 text-primary"></i> My Shopping Cart</a></li>
            <li><hr class="dropdown-divider"></li>
            @if (isAdmin)
            {
                <li><a class="dropdown-item d-flex align-items-center gap-2" asp-controller="Admin" asp-action="Dashboard"><i class="bi bi-speedometer2 text-danger"></i> Admin Dashboard</a></li>
                <li><a class="dropdown-item d-flex align-items-center gap-2" asp-controller="Admin" asp-action="Products"><i class="bi bi-boxes text-danger"></i> Inventory Manager</a></li>
                <li><a class="dropdown-item d-flex align-items-center gap-2" asp-controller="Admin" asp-action="Orders"><i class="bi bi-receipt text-danger"></i> Fulfillment Desk</a></li>
                <li><hr class="dropdown-divider"></li>
            }
            <li>
                <form class="form-inline px-2 py-1" asp-controller="Account" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-danger btn-sm w-100 d-flex align-items-center justify-content-center gap-2">
                        <i class="bi bi-box-arrow-right"></i> Sign Out
                    </button>
                </form>
            </li>
        </ul>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link text-dark fw-medium px-2" asp-controller="Account" asp-action="Login">Sign In</a>
    </li>
    <li class="nav-item">
        <a class="btn btn-success btn-sm px-3 shadow-sm rounded-pill fw-medium" asp-controller="Account" asp-action="Register">Register</a>
    </li>
}
</ul>
